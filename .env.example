# All features below are optional. The core mashup studio runs entirely in the browser.

# Cloud library + AI stems both need a Vercel Blob store. Vercel adds this automatically when
# you create a Blob store on the project (Storage tab). Without it the library is browser-only.
BLOB_READ_WRITE_TOKEN=

# AI stem separation (Demucs via Replicate). Needs BLOB_READ_WRITE_TOKEN as well.
REPLICATE_API_TOKEN=

# "Ask Claude for a plan" (Mash advisor)
ANTHROPIC_API_KEY=

# Strongly recommended on a public deployment: a code users must enter once before they can
# read or change the cloud library or start a (paid) separation.
ACCESS_CODE=

# Optional: override the Demucs model. Pin a version id, or point at another owner/name.
# DEMUCS_MODEL=ryan5453/demucs
# DEMUCS_VERSION=
# DEMUCS_MODEL_VARIANT=htdemucs

# Optional: secret used to sign the Replicate completion callback (defaults to ACCESS_CODE, then REPLICATE_API_TOKEN)
# STEMS_WEBHOOK_SECRET=
