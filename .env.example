# All features below are optional. The core mashup studio runs entirely in the browser.

# "Ask Claude for a plan" (Mash advisor)
ANTHROPIC_API_KEY=

# AI stem separation (Demucs via Replicate). Both are required for the feature to light up.
REPLICATE_API_TOKEN=
BLOB_READ_WRITE_TOKEN=
# Optional: protect the paid stem endpoints with a shared code users must enter once.
STEMS_ACCESS_CODE=
# Optional: override the Demucs model. Either pin a version id or point at another owner/name.
# DEMUCS_MODEL=ryan5453/demucs
# DEMUCS_VERSION=
# DEMUCS_MODEL_VARIANT=htdemucs
